<view class="trip-card" bindtap="openTrip">
  <view class="trip-card__header">
    <view class="trip-card__route">
      <text>{{trip.from || '未填写'}}</text>
      <text class="trip-card__arrow">?</text>
      <text>{{trip.to || '未填写'}}</text>
    </view>
    <view class="trip-card__badge {{trip.ownerVerified ? 'trip-card__badge--verified' : ''}}">
      {{trip.ownerVerified ? '已认证' : '未认证'}}
    </view>
  </view>
  <view class="trip-card__meta">
    <text>{{formatTime(trip.earliestTime, trip.latestTime)}}</text>
    <text class="trip-card__dot">?</text>
    <text>{{trip.peopleCount || 1}}人同行</text>
  </view>
  <view class="trip-card__note">{{trip.note || '无备注'}}</view>
  <view class="trip-card__footer">
    <text>发布者：{{trip.ownerNickname || '同学'}}</text>
    <text class="trip-card__open">查看详情</text>
  </view>
</view>
