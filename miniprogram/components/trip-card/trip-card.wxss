.trip-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.08);
}

.trip-card__header,
.trip-card__footer,
.trip-card__meta {
  display: flex;
  align-items: center;
}

.trip-card__header,
.trip-card__footer {
  justify-content: space-between;
}

.trip-card__route {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.trip-card__arrow {
  color: #004ea2;
}

.trip-card__badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 22rpx;
}

.trip-card__badge--verified {
  background: #dcfce7;
  color: #15803d;
}

.trip-card__meta {
  margin-top: 18rpx;
  color: #475569;
  font-size: 26rpx;
}

.trip-card__dot {
  margin: 0 12rpx;
  color: #94a3b8;
}

.trip-card__note {
  margin-top: 18rpx;
  color: #334155;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.trip-card__footer {
  margin-top: 18rpx;
  color: #64748b;
  font-size: 24rpx;
}

.trip-card__open {
  color: #004ea2;
  font-weight: 700;
}
