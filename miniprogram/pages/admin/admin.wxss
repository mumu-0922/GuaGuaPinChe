.admin-placeholder {
  padding-bottom: 56rpx;
}

.admin-placeholder__card {
  padding: 36rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.admin-placeholder__title {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 900;
}

.admin-placeholder__desc {
  margin-top: 16rpx;
  color: #64748b;
  line-height: 1.6;
}
