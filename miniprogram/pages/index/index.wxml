<view class="safe-area plaza">
  <view class="hero">
    <view>
      <view class="hero__eyebrow">NWPU Carpool</view>
      <view class="hero__title">西工大拼车助手</view>
    </view>
    <button class="hero__button" bindtap="goPublish">发起拼车</button>
  </view>

  <view class="safety-tip">安全提示：仅做校内出行信息撮合，不要坐黑车，费用只做合理分摊。</view>

  <view class="filter-panel">
    <view class="field-row">
      <label class="field" bindtap="setChoosingField" data-field="from">
        <text class="field__label">出发地</text>
        <input value="{{filters.from}}" placeholder="如：长安校区" data-field="from" bindinput="setFilter" />
      </label>
      <button class="swap-button" bindtap="swapRoute">&#8644;</button>
      <label class="field" bindtap="setChoosingField" data-field="to">
        <text class="field__label">到达地</text>
        <input value="{{filters.to}}" placeholder="如：咸阳机场" data-field="to" bindinput="setFilter" />
      </label>
    </view>

    <label class="field field--keyword">
      <text class="field__label">关键词</text>
      <input value="{{filters.keyword}}" placeholder="T5 / 高铁 / 行李" data-field="keyword" bindinput="setFilter" confirm-type="search" bindconfirm="loadTrips" />
    </label>

    <view class="chips-section">
      <view class="chips-title">常用地点（当前填入：{{choosingField === 'from' ? '出发地' : '到达地'}}）</view>
      <view class="group" wx:for="{{locationGroups}}" wx:key="label">
        <view class="group__label">{{item.icon}} {{item.label}}</view>
        <view class="chips">
          <button class="chip" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" data-field="{{choosingField}}" data-value="{{option}}" bindtap="chooseLocation">{{option}}</button>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="secondary-button action-button" bindtap="resetFilters">重置</button>
      <button class="primary-button action-button" bindtap="loadTrips">搜索</button>
    </view>
  </view>

  <view class="list-header">
    <text>行程卡片</text>
    <text class="list-header__count">{{trips.length}} 条</text>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{loading && trips.length === 0}}" class="loading">加载中...</view>
  <view wx:elif="{{trips.length === 0}}" class="empty">暂无匹配行程</view>

  <view wx:else class="trip-list">
    <trip-card wx:for="{{trips}}" wx:key="_id" trip="{{item}}" bind:open="openTrip" />
    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:elif="{{hasMore}}" class="load-more">上拉加载更多</view>
    <view wx:else class="load-more">已到底</view>
  </view>
</view>
