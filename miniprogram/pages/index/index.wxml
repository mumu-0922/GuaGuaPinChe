<view class="safe-area plaza">
  <view class="hero">
    <view>
      <view class="hero__eyebrow">NWPU Carpool</view>
      <view class="hero__title">\u897f\u5de5\u5927\u62fc\u8f66\u52a9\u624b</view>
    </view>
    <button class="hero__button" bindtap="goPublish">\u53d1\u8d77\u62fc\u8f66</button>
  </view>

  <view class="safety-tip">\u5b89\u5168\u63d0\u793a\uff1a\u4ec5\u505a\u6821\u5185\u51fa\u884c\u4fe1\u606f\u64ae\u5408\uff0c\u4e0d\u8981\u5750\u9ed1\u8f66\uff0c\u8d39\u7528\u53ea\u505a\u5408\u7406\u5206\u644a\u3002</view>

  <view class="filter-panel">
    <view class="field-row">
      <label class="field" bindtap="setChoosingField" data-field="from">
        <text class="field__label">\u51fa\u53d1\u5730</text>
        <input value="{{filters.from}}" placeholder="\u5982\uff1a\u957f\u5b89\u6821\u533a" data-field="from" bindinput="setFilter" />
      </label>
      <button class="swap-button" bindtap="swapRoute">&#8644;</button>
      <label class="field" bindtap="setChoosingField" data-field="to">
        <text class="field__label">\u5230\u8fbe\u5730</text>
        <input value="{{filters.to}}" placeholder="\u5982\uff1a\u54b8\u9633\u673a\u573a" data-field="to" bindinput="setFilter" />
      </label>
    </view>

    <label class="field field--keyword">
      <text class="field__label">\u5173\u952e\u8bcd</text>
      <input value="{{filters.keyword}}" placeholder="T5 / \u9ad8\u94c1 / \u884c\u674e" data-field="keyword" bindinput="setFilter" confirm-type="search" bindconfirm="loadTrips" />
    </label>

    <view class="chips-section">
      <view class="chips-title">\u5e38\u7528\u5730\u70b9\uff08\u5f53\u524d\u586b\u5165\uff1a{{choosingField === 'from' ? '\u51fa\u53d1\u5730' : '\u5230\u8fbe\u5730'}}\uff09</view>
      <view class="group" wx:for="{{locationGroups}}" wx:key="label">
        <view class="group__label">{{item.icon}} {{item.label}}</view>
        <view class="chips">
          <button class="chip" wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" data-field="{{choosingField}}" data-value="{{option}}" bindtap="chooseLocation">{{option}}</button>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="secondary-button action-button" bindtap="resetFilters">\u91cd\u7f6e</button>
      <button class="primary-button action-button" bindtap="loadTrips">\u641c\u7d22</button>
    </view>
  </view>

  <view class="list-header">
    <text>\u884c\u7a0b\u5361\u7247</text>
    <text class="list-header__count">{{trips.length}} \u6761</text>
  </view>

  <view wx:if="{{error}}" class="error-box">{{error}}</view>
  <view wx:if="{{loading && trips.length === 0}}" class="loading">\u52a0\u8f7d\u4e2d...</view>
  <view wx:elif="{{trips.length === 0}}" class="empty">\u6682\u65e0\u5339\u914d\u884c\u7a0b</view>

  <view wx:else class="trip-list">
    <trip-card wx:for="{{trips}}" wx:key="_id" trip="{{item}}" bind:open="openTrip" />
    <view wx:if="{{loading}}" class="loading">\u52a0\u8f7d\u4e2d...</view>
    <view wx:elif="{{hasMore}}" class="load-more">\u4e0a\u62c9\u52a0\u8f7d\u66f4\u591a</view>
    <view wx:else class="load-more">\u5df2\u5230\u5e95</view>
  </view>
</view>
