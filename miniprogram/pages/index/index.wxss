.plaza {
  padding-bottom: 48rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #004ea2, #2563eb);
  box-shadow: 0 16rpx 40rpx rgba(0, 78, 162, 0.22);
}

.hero__eyebrow {
  opacity: 0.78;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hero__title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.hero__button {
  margin: 0;
  padding: 0 24rpx;
  min-width: 176rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #004ea2;
  font-size: 26rpx;
  font-weight: 800;
}

.safety-tip,
.filter-panel,
.error-box,
.loading,
.empty {
  margin-top: 24rpx;
  border-radius: 28rpx;
}

.safety-tip {
  padding: 22rpx 26rpx;
  background: #fff7ed;
  color: #9a3412;
  line-height: 1.6;
}

.filter-panel {
  padding: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field {
  flex: 1;
  display: block;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
}

.field--keyword {
  margin-top: 18rpx;
}

.field__label {
  display: block;
  margin-bottom: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.field input {
  color: #0f172a;
  font-size: 28rpx;
}

.swap-button {
  margin: 0;
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #e8f1ff;
  color: #004ea2;
  font-weight: 900;
}

.chips-section {
  margin-top: 22rpx;
}

.chips-title {
  color: #334155;
  font-weight: 700;
}

.group {
  margin-top: 18rpx;
}

.group__label {
  color: #64748b;
  font-size: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}

.chip {
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.action-button {
  flex: 1;
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 18rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
}

.list-header__count {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 500;
}

.error-box {
  padding: 22rpx;
  background: #fee2e2;
  color: #b91c1c;
}

.loading,
.empty,
.load-more {
  padding: 32rpx;
  text-align: center;
  color: #64748b;
}

.empty {
  background: #ffffff;
}

.trip-list {
  margin-top: 18rpx;
}
